{
  "name": "routiq",
  "version": "0.1.1",
  "description": "Expose localhost to the internet through Routiq tunnels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayush844/Routiq.git",
    "directory": "apps/cli"
  },
  "homepage": "https://routiq.dev",
  "type": "module",
  "bin": {
    "routiq": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --external:figlet --outfile=dist/index.cjs",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "colors": "^1.4.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "log-symbols": "^7.0.1",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "string-width": "^8.2.1",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@types/colors": "^1.2.4",
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
