# Copy to apps/relay/.env on your VPS and fill in secrets.
TOKEN_SECRET=
DATABASE_URL=
REDIS_URL=redis://redis:6379

# Relay instances set these in docker-compose (relay-1, relay-2).
# RELAY_ID=relay-1
# WS_PORT=8081
# HTTP_PORT=3001

PUBLIC_HTTP_PORT=443
TUNNEL_DOMAIN=routiq.dev
PUBLIC_TUNNEL_SCHEME=https
